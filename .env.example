VITE_API_BASE_URL=http://localhost:8000/api/v1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smart_warehouse
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_USE_PURE=true
AI_PROVIDER=local
AI_EXTERNAL_ENABLED=false
